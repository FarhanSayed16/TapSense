# Copy to .env and fill in. Never commit .env

APP_NAME=TapSense API
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MONGODB_URI=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/tapsense?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority&appName=TapSense
MONGODB_DB=tapsense

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=tapsense/pilot/device_01/telemetry
MQTT_ENABLED=true

DEVICE_API_KEY=pilot-device-key-change-me
CAMPUS_TIMEZONE=Asia/Kolkata

SESSION_IDLE_SECONDS=5
LONG_TAIL_LITERS=5.0
LONG_TAIL_SECONDS=120
DEVICE_STALE_SECONDS=300

ADMIN_EMAIL=admin@tapsense.app
ADMIN_PASSWORD=TapSenseAdmin123!
ADMIN_NAME=TapSense Admin

# Upstash Redis REST (optional — leave blank to disable)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_ENABLED=false
REDIS_KEY_PREFIX=tapsense:
